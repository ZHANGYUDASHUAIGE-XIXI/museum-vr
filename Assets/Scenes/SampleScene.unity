--- !u!114 &207693703
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 207693699}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a265347e81fa5074f8904cdfa0c2ecaf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  questionTxt: {fileID: 1603239286}
  optionBtns:
  - {fileID: 908982546}
  - {fileID: 1666550197}
  - {fileID: 219748291}
  - {fileID: 1282091730}
  tipTxt: {fileID: 1493338503}
  operateBtn: {fileID: 672876669}
  operateBtnTxt: {fileID: 1261800913}
  prevBtn: {fileID: 1638108972}
  scoreTxt: {fileID: 259468813}
  questionList:
  - questionText: "\u864E\u5EA7\u9E1F\u67B6\u9F13\u7684\u4E3B\u8981\u7528\u9014\u662F\uFF1F"
    optionTexts:
    - "  A. \u4F5C\u6218\u5175\u5668"
    - "  B. \u796D\u7940\u4E50\u5668"
    - "  C. \u65E5\u5E38\u98DF\u5668"
    - "  D. \u5EFA\u7B51\u6784\u4EF6"
    correctIndex: 1
    explain: "\u864E\u5EA7\u9E1F\u67B6\u9F13\u662F\u695A\u56FD\u7528\u4E8E\u796D\u7940\u3001\u5BB4\u4E50\u7684\u6253\u51FB\u4E50\u5668\uFF0C\u4EE5\u864E\u4E3A\u5EA7\u3001\u51E4\u4E3A\u67B6\uFF0C\u662F\u695A\u5F0F\u6F06\u5668\u4EE3\u8868\u3002"
  - questionText: "\u4E91\u68A6\u7761\u864E\u5730\u79E6\u7B80\u7684\u6838\u5FC3\u5185\u5BB9\u662F\uFF1F"
    optionTexts:
    - "  A. \u8BD7\u6B4C\u6587\u96C6"
    - "  B. \u6CD5\u5F8B\u6587\u4E66"
    - "  C. \u5929\u6587\u5386\u6CD5"
    - "  D. \u533B\u65B9\u836F\u65B9"
    correctIndex: 1
    explain: "\u7761\u864E\u5730\u79E6\u7B80\u4EE5\u79E6\u4EE3\u6CD5\u5F8B\u6587\u4E66\u4E3A\u4E3B\uFF0C\u662F\u7814\u7A76\u79E6\u4EE3\u6CD5\u5F8B\u5236\u5EA6\u7684\u91CD\u8981\u5B9E\u7269\u3002"
  - questionText: "\u5D07\u9633\u94DC\u9F13\u7684\u5E74\u4EE3\u662F\uFF1F"
    optionTexts:
    - "  A. \u5546\u4EE3\u665A\u671F"
    - "  B. \u6218\u56FD\u65F6\u671F"
    - "  C. \u6C49\u4EE3\u65E9\u671F"
    - "  D. \u5510\u4EE3\u4E2D\u671F"
    correctIndex: 0
    explain: "\u4E2D\u56FD\u73B0\u5B58\u6700\u65E9\u7684\u5546\u4EE3\u665A\u671F\u94DC\u9F13\uFF0C\u662F\u7814\u7A76\u5546\u4EE3\u9752\u94DC\u4E0E\u97F3\u4E50\u6587\u5316\u7684\u91CD\u8981\u5B9E\u7269\u3002"
  - questionText: "\u8D8A\u738B\u52FE\u8DF5\u5251\u51FA\u571F\u4E8E\uFF1F"
    optionTexts:
    - "  A. \u66FE\u4FAF\u4E59\u5893"
    - "  B. \u671B\u5C71\u695A\u5893"
    - "  C. \u9A6C\u738B\u5806\u6C49\u5893"
    - "  D. \u4E5D\u8FDE\u58A9\u695A\u5893"
    correctIndex: 1
    explain: "\u8D8A\u738B\u52FE\u8DF5\u5251 1965 \u5E74\u51FA\u571F\u4E8E\u6E56\u5317\u6C5F\u9675\u671B\u5C71
      1 \u53F7\u695A\u5893\uFF0C\u662F\u5434\u8D8A\u9752\u94DC\u5251\u7684\u5DC5\u5CF0\u4E4B\u4F5C\u3002"
  - questionText: "\u66FE\u4FAF\u4E59\u7F16\u949F\u7684\u6838\u5FC3\u6280\u672F\u7279\u70B9\u662F\uFF1F"
    optionTexts:
    - "  A. \u4E00\u949F\u53CC\u97F3"
    - "  B. \u5355\u97F3\u5355\u949F "
    - "  C. \u9676\u74F7\u6750\u8D28"
    - "  D. \u4EC5\u7528\u4E8E\u966A\u846C"
    correctIndex: 0
    explain: "\u7F16\u949F\u91C7\u7528 \u201C\u4E00\u949F\u53CC\u97F3\u201D \u6280\u672F\uFF0C\u80FD\u53D1\u51FA\u4E24\u4E2A\u4E0D\u540C\u97F3\u9AD8\u7684\u4E50\u97F3\uFF0C\u6539\u5199\u4E86\u4E16\u754C\u97F3\u4E50\u53F2\u3002"
  - questionText: "\u66FE\u4FAF\u4E59\u5C0A\u76D8\u7684\u94F8\u9020\u5DE5\u827A\u662F\uFF1F"
    optionTexts:
    - "  A. \u5931\u8721\u6CD5"
    - "  B. \u8303\u94F8\u6CD5"
    - "  C. \u953B\u6253\u6CD5"
    - "  D. \u710A\u63A5\u6CD5"
    correctIndex: 0
    explain: "\u4EE5\u5931\u8721\u6CD5\u94F8\u9020\uFF0C\u7EB9\u9970\u7E41\u590D\u7CBE\u5BC6\uFF0C\u4EE3\u8868\u4E86\u5148\u79E6\u9752\u94DC\u5DE5\u827A\u7684\u6700\u9AD8\u6C34\u5E73\u3002"
  - questionText: "\u90E7\u53BF\u4EBA\u5934\u5316\u77F3\u5C5E\u4E8E\u54EA\u4E00\u9636\u6BB5\u4EBA\u7C7B\uFF1F"
    optionTexts:
    - "  A. \u665A\u671F\u667A\u4EBA"
    - "  B. \u65E9\u671F\u667A\u4EBA"
    - "  C. \u76F4\u7ACB\u4EBA"
    - "  D. \u73B0\u4EE3\u4EBA"
    correctIndex: 2
    explain: "\u8DDD\u4ECA\u7EA6 100 \u4E07\u5E74\uFF0C\u5C5E\u4E8E\u76F4\u7ACB\u4EBA\u9636\u6BB5\uFF0C\u662F\u4E1C\u4E9A\u4EBA\u7C7B\u6F14\u5316\u7684\u91CD\u8981\u8BC1\u636E\u3002"
  - questionText: "\u77F3\u5BB6\u6CB3\u7389\u4EBA\u50CF\u7684\u63A8\u6D4B\u7528\u9014\u662F\uFF1F"
    optionTexts:
    - "  A. \u88C5\u9970\u9970\u54C1"
    - "  B. \u796D\u7940\u793C\u5668"
    - "  C. \u65E5\u5E38\u5DE5\u5177"
    - "  D. \u73A9\u5177\u6446\u4EF6"
    correctIndex: 1
    explain: "\u9020\u578B\u5E84\u4E25\uFF0C\u63A8\u6D4B\u4E3A\u53F2\u524D\u796D\u7940\u7528\u793C\u5668\uFF0C\u53CD\u6620\u4E86\u5F53\u65F6\u7684\u5B97\u6559\u4FE1\u4EF0\u3002"
  - questionText: "\u5143\u9752\u82B1 \u201C\u56DB\u7231\u201D \u4E0D\u5305\u62EC\u4EE5\u4E0B\u54EA\u9879\uFF1F"
    optionTexts:
    - "  A. \u738B\u7FB2\u4E4B\u7231\u5170"
    - "  B. \u9676\u6E0A\u660E\u7231\u83CA"
    - "  C. \u674E\u767D\u7231\u9152"
    - "  D. \u6797\u548C\u9756\u7231\u6885"
    correctIndex: 2
    explain: "\u201C\u56DB\u7231\u201D \u6307\u738B\u7FB2\u4E4B\u7231\u5170\u3001\u9676\u6E0A\u660E\u7231\u83CA\u3001\u5468\u6566\u9890\u7231\u83B2\u3001\u6797\u548C\u9756\u7231\u6885\uFF0C\u65E0\u674E\u767D\u7231\u9152\u3002"
  - questionText: "\u5F69\u7ED8\u4EBA\u7269\u8F66\u9A6C\u51FA\u884C\u56FE\u7684\u8F7D\u4F53\u662F\uFF1F"
